@model UserLoginViewModel
@{
    ViewData["Title"] = "Login";
}
<section class="auth-section">
    <div class="auth-overlay"></div>
    <div class="container d-flex justify-content-center align-items-center min-vh-100">
        <div class="glass-card auth-card">
            <h3 class="mb-4">Welcome Back</h3>
            <form asp-action="Login" method="post" class="needs-validation">
                @Html.AntiForgeryToken()
                <div class="form-floating mb-3">
                    <input asp-for="EmailAddress" class="form-control" placeholder="name@example.com" />
                    <label asp-for="EmailAddress">Email</label>
                    <span class="text-danger" asp-validation-for="EmailAddress"></span>
                </div>
                <div class="form-floating mb-3">
                    <input asp-for="Password" class="form-control" placeholder="Password" />
                    <label asp-for="Password">Password</label>
                    <span class="text-danger" asp-validation-for="Password"></span>
                </div>
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div class="form-check">
                        <input class="form-check-input" asp-for="RememberMe" />
                        <label class="form-check-label" asp-for="RememberMe">Remember me</label>
                    </div>
                    <a class="text-light small" href="#">Forgot password?</a>
                </div>
                <button type="submit" class="btn btn-glow w-100">Login</button>
                <div class="text-center mt-3">
                    <a class="text-light" asp-controller="Registration" asp-action="Register">Create an account</a>
                </div>
                <div class="text-danger mt-2">
                    @Html.ValidationSummary(false)
                </div>
            </form>
        </div>
    </div>
</section>
