@{
    ViewData["Title"] = "Join WeCare";
}

<section class="auth-section">
    <div class="auth-overlay"></div>
    <div class="container d-flex align-items-center min-vh-100">
        <div class="row justify-content-center w-100">
            <div class="col-lg-8">
                <div class="glass-card registration-shell text-center">
                    <p class="text-uppercase text-warning mb-2">WeCare Community</p>
                    <h2 class="registration-title mb-4">Join WeCare</h2>
                    <p class="text-white-50 mb-4">Choose the type of registration that fits your mission.</p>
                    <div class="row g-4">
                        <div class="col-md-6">
                            <div class="glass-card select-card h-100" data-target="/Registration/Individual">
                                <div class="select-card-icon mb-3"><i class="bi bi-person"></i></div>
                                <h5>Individual</h5>
                                <p class="form-help">Register as a blood donor or seeker.</p>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="glass-card select-card h-100" data-target="/Registration/Organization">
                                <div class="select-card-icon mb-3"><i class="bi bi-building"></i></div>
                                <h5>Organization</h5>
                                <p class="form-help">Register as hospital, NGO, or foundation.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
